generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String        @id @default(cuid())
  name       String
  email      String        @unique
  password   String
  role       String        @default("SEEKER")
  plan       String        @default("FREE")
  resumeUrl  String?
  phone      String?
  city       String?
  skills     String?
  education  String?
  experience String?
  jobs       Job[]
  apps       Application[]
  saved      SavedJob[]
  reports    Report[]
  createdAt  DateTime      @default(now())
}

model Job {
  id          String        @id @default(cuid())
  title       String
  company     String
  location    String
  mode        String
  minExp      Int           @default(0)
  salary      Int
  skills      String
  description String
  status      String        @default("APPROVED")
  expiresAt   DateTime?
  postedBy    User          @relation(fields: [postedById], references: [id])
  postedById  String
  apps        Application[]
  saved       SavedJob[]
  reports     Report[]
  createdAt   DateTime      @default(now())
}

model Application {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String
  status    String   @default("APPLIED")
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
}

model SavedJob {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String
  job    Job    @relation(fields: [jobId], references: [id])
  jobId  String

  @@unique([userId, jobId])
}

model Report {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String
  reason    String
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  orderId   String   @unique
  paymentId String?
  amount    Int
  status    String   @default("CREATED")
  createdAt DateTime @default(now())
}
